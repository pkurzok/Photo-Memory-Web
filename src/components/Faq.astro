---
import { content, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}

const { faq } = content[Astro.props.lang];
---

<section id="faq" class="section">
  <div class="container">
    <div class="section-header">
      <h2>{faq.title}</h2>
    </div>
    <div class="faq-accordion">
      {
        faq.items.map((entry) => (
          // The shared name makes the browser close the open entry when another one opens.
          <details name="faq" class="faq-item">
            <summary>{entry.question}</summary>
            <p class="faq-answer">{entry.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
