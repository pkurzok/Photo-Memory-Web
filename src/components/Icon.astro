interface Props {
  // A key of the list above; the feature tiles take theirs from the language files.
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
if (!(name in icons)) throw new Error(`Icon "${name}" is missing in src/components/Icon.astro`);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  class:list={['icon', className]}
  width="1em"
  height="1em"
  viewBox="0 0 16 16"
  fill="currentColor"
  aria-hidden="true"
  set:html={icons[name]}
/>
