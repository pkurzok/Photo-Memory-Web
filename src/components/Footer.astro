---
import { content, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  // false leaves out the tagline: the shared-set page speaks two languages.
  nav?: boolean;
  // The same page in the other language, when there is one.
  language?: { label: string; lang: Lang; href: string };
}

const { lang, nav = true, language } = Astro.props;
const { footer } = content[lang];
---

<footer class="site-footer">
  <div class="container">
    {nav && <p class="footer-tagline">{footer.tagline}</p>}
    <div class="footer-links">
      {
        footer.links.map((entry) => (
          <a href={entry.href} class="footer-link">
            {entry.label}
          </a>
        ))
      }
      {
        language && (
          <a href={language.href} class="footer-link" lang={language.lang} hreflang={language.lang}>
            {language.label}
          </a>
        )
      }
    </div>
    <p class="footer-copyright">{footer.copyright}</p>
  </div>
</footer>
