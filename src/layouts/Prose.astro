---
// Layout for pages written in Markdown; the frontmatter supplies language, title, description
// and path.
import { content, type Lang } from '../data/site';
import Base from './Base.astro';

interface Props {
  frontmatter: {
    lang: Lang;
    title: string;
    description: string;
    path: string;
  };
}

const { lang, title, description, path } = Astro.props.frontmatter;
---

<Base lang={lang} title={`${title} - ${content[lang].shortName}`} description={description} path={path}>
  <div class="prose-page">
    <div class="container">
      <div class="prose">
        <slot />
      </div>
    </div>
  </div>
</Base>
